{
  "name": "blinkbuddy",
  "productName": "BlinkBuddy",
  "version": "0.1.3",
  "description": "A tiny desktop companion that blinks at you so you remember to blink too.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "lottie-web": "^5.12.2"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.blinkbuddy.app",
    "productName": "BlinkBuddy",
    "files": ["src/**/*", "library/**/*", "package.json"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
